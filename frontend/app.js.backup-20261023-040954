(() => {
  "use strict";

  const $ = (id) => document.getElementById(id);
  const state = {
    conversationId: null,
    conversations: [],
    busy: false,
    sessionReady: false,
    closing: false
  };

  const transcript = $("transcript");
  const messages = $("messages");
  const welcome = $("welcome");
  const input = $("message-input");
  const sendButton = $("send-button");
  const notice = $("notice");
  const toast = $("toast");
  let toastTimer;

  async function api(path, options = {}) {
    const response = await fetch(path, {
      credentials: "same-origin",
      ...options,
      headers: {
        ...(options.body ? { "Content-Type": "application/json" } : {}),
        ...(options.headers || {})
      }
    });

    let data = {};
    try { data = await response.json(); } catch (_) {}

    if (!response.ok) {
      const error = new Error(data.error || data.detail || `HTTP ${response.status}`);
      error.status = response.status;
      throw error;
    }
    return data;
  }

  function showToast(message) {
    toast.textContent = message;
    toast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => { toast.hidden = true; }, 4200);
  }

  function setConnection(connected, label) {
    $("connection-dot").classList.toggle("offline", !connected);
    $("connection-label").textContent = label;
  }

  function showNotice(message) {
    notice.textContent = message || "";
    notice.hidden = !message;
  }

  function setBusy(busy) {
    state.busy = busy;
    sendButton.disabled = busy;
    $("new-chat").disabled = busy;
    input.disabled = busy;
    $("send-label").textContent = busy ? "???? ?????" : "?????";
  }

  function scrollToLatest() {
    const nearBottom = transcript.scrollHeight - transcript.scrollTop - transcript.clientHeight < 160;
    if (nearBottom) transcript.scrollTop = transcript.scrollHeight;
  }

  function addMessage(role, content, options = {}) {
    const article = document.createElement("article");
    article.className = `message ${role}`;

    const label = document.createElement("div");
    label.className = "message-role";
    label.textContent = role === "user" ? "???" : "?????????";
    article.appendChild(label);

    const body = document.createElement("div");
    body.className = "message-content";
    body.dir = "auto";
    body.textContent = content;
    article.appendChild(body);

    if (options.pending) {
      body.classList.add("pending");
      body.textContent = "????????? ???????";
      article.dataset.pending = "true";
    }

    if (role === "assistant" && !options.pending) {
      const actions = document.createElement("div");
      actions.className = "message-actions";
      const copy = document.createElement("button");
      copy.type = "button";
      copy.textContent = "??? ????";
      copy.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(content);
          showToast("?? ??? ????.");
        } catch (_) {
          showToast("????? ?????. ???? ????? ???? ????? ??????.");
        }
      });
      actions.appendChild(copy);
      article.appendChild(actions);
    }

    messages.appendChild(article);
    welcome.hidden = true;
    scrollToLatest();
    return article;
  }

  function showWelcome() {
    messages.replaceChildren();
    welcome.hidden = false;
  }

  function renderConversationList() {
    const list = $("conversation-list");
    list.replaceChildren();

    for (const item of state.conversations) {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "conversation-item";
      button.classList.toggle("active", item.conversation_id === state.conversationId);
      button.textContent = item.title || "?????? ?????";
      button.title = item.title || "?????? ?????";
      button.addEventListener("click", () => openConversation(item.conversation_id));
      list.appendChild(button);
    }
  }

  async function refreshConversations() {
    const data = await api("/api/conversations");
    state.conversations = data.conversations || [];
    renderConversationList();
  }

  async function ensureSession() {
    try {
      await api("/api/conversations");
      state.sessionReady = true;
      return;
    } catch (error) {
      if (![401, 404].includes(error.status)) throw error;
    }

    await api("/api/session", { method: "POST" });
    state.sessionReady = true;
  }

  async function createConversation() {
    const data = await api("/api/conversations", {
      method: "POST",
      body: JSON.stringify({})
    });
    state.conversationId = data.conversation_id;
    $("current-title").textContent = data.title || "????? ?????";
    showWelcome();
    await refreshConversations();
    closeSidebar();
    input.focus();
  }

  async function openConversation(id) {
    if (state.busy) return;
    showNotice("");
    try {
      const data = await api(`/api/conversations/${encodeURIComponent(id)}`);
      state.conversationId = data.conversation_id;
      $("current-title").textContent = data.title || "????? ?????";
      messages.replaceChildren();
      welcome.hidden = true;

      if (!data.messages || data.messages.length === 0) {
        showWelcome();
      } else {
        for (const message of data.messages) {
          addMessage(message.role === "user" ? "user" : "assistant", message.content);
        }
      }
      renderConversationList();
      closeSidebar();
      transcript.scrollTop = transcript.scrollHeight;
    } catch (error) {
      handleError(error, "????? ??? ????????.");
    }
  }

  async function sendMessage(text) {
    const content = text.trim();
    if (!content || state.busy) return;

    if (!state.conversationId) {
      await createConversation();
    }

    input.value = "";
    resizeInput();
    addMessage("user", content);
    const pending = addMessage("assistant", "", { pending: true });
    setBusy(true);
    showNotice("");

    try {
      const data = await api(
        `/api/conversations/${encodeURIComponent(state.conversationId)}/messages`,
        { method: "POST", body: JSON.stringify({ content }) }
      );

      pending.remove();
      if (data.done) {
        addMessage("assistant", data.content || "");
        setConnection(true, "????");
      } else {
        addMessage("assistant", "???? ?? ?????. ???? ????? ??????? ??? ????.");
      }
      await refreshConversations();
    } catch (error) {
      pending.remove();
      const failed = addMessage(
        "assistant",
        "?? ????? ?? ????? ????. ????? ????? ????? ??????."
      );
      const retry = document.createElement("button");
      retry.type = "button";
      retry.className = "text-button";
      retry.textContent = "????? ????????";
      retry.addEventListener("click", () => sendMessage(content));
      const actions = document.createElement("div");
      actions.className = "message-actions";
      actions.appendChild(retry);
      failed.appendChild(actions);
      handleError(error, "????? ????? ???????.");
    } finally {
      setBusy(false);
      input.focus();
    }
  }

  function handleError(error, fallback) {
    const message = error.status === 429
      ? "????? ???? ?????? ?????????. ????? ?????? ?? ???? ??????."
      : error.status === 503
        ? "??????? ??? ???? ??????. ???? ?? Ollama ???? ?? ???? ??? ????."
        : error.status === 401 || error.status === 404
          ? "????? ?????? ???????. ???? ???? ????? ????????."
          : fallback;

    showNotice(message);
    setConnection(false, "??? ????");
    showToast(message);
  }

  function resizeInput() {
    input.style.height = "auto";
    input.style.height = `${Math.min(input.scrollHeight, 180)}px`;
  }

  function closeSidebar() {
    $("sidebar").classList.remove("open");
  }

  $("composer").addEventListener("submit", (event) => {
    event.preventDefault();
    sendMessage(input.value);
  });

  input.addEventListener("keydown", (event) => {
    if (event.key === "Enter" && !event.shiftKey && !event.isComposing) {
      event.preventDefault();
      $("composer").requestSubmit();
    }
  });
  input.addEventListener("input", resizeInput);

  $("new-chat").addEventListener("click", async () => {
    if (state.busy) return;
    try {
      await createConversation();
    } catch (error) {
      handleError(error, "????? ????? ?????? ?????.");
    }
  });

  $("menu-toggle").addEventListener("click", () => {
    $("sidebar").classList.toggle("open");
  });

  document.querySelectorAll("[data-prompt]").forEach((button) => {
    button.addEventListener("click", () => {
      input.value = button.dataset.prompt || "";
      resizeInput();
      input.focus();
    });
  });

  $("end-session").addEventListener("click", async () => {
    if (state.busy || state.closing) return;
    if (!confirm("?? ???? ????? ?????? ???? ?? ????????? ????????")) return;

    state.closing = true;
    try {
      await api("/api/session", { method: "DELETE" });
      state.sessionReady = false;
      state.conversationId = null;
      state.conversations = [];
      renderConversationList();
      showWelcome();
      $("current-title").textContent = "????? ?????";
      await ensureSession();
      await createConversation();
      showToast("????? ?????? ??????? ????? ???? ?????.");
    } catch (error) {
      handleError(error, "????? ????? ??????.");
    } finally {
      state.closing = false;
    }
  });

  window.addEventListener("pagehide", (event) => {
    if (!event.persisted && state.sessionReady && !state.closing) {
      fetch("/api/session", {
        method: "DELETE",
        credentials: "same-origin",
        keepalive: true
      }).catch(() => {});
    }
  });

  async function init() {
    try {
      await ensureSession();
      await refreshConversations();
      setConnection(true, "????");

      if (state.conversations.length) {
        await openConversation(state.conversations[0].conversation_id);
      } else {
        await createConversation();
      }
    } catch (error) {
      handleError(error, "????? ??????? ????????. ???? ?? ???? HADOTA ????.");
    }
  }

  init();
})();
